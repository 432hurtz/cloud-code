# ─── GCP ────────────────────────────────────────────────────────────────────
PROJECT_ID=your-gcp-project
REGION=us-central1
ZONE=us-central1-a

# ─── GPU / VM ───────────────────────────────────────────────────────────────
# A100 (power pick). For the cheap L4 alternative:
#   MACHINE_TYPE=g2-standard-8   GPU_TYPE=nvidia-l4        GPU_COUNT=1
MACHINE_TYPE=a2-highgpu-1g
GPU_TYPE=nvidia-tesla-a100
GPU_COUNT=1
VM_NAME=code-builder
BOOT_DISK_GB=50

# ─── Model disk ─────────────────────────────────────────────────────────────
MODEL_DISK_NAME=code-model-disk
MODEL_DISK_GB=60
# Ollama model tag. A100 40GB comfortably runs the 32B coder at q8.
#   L4 24GB: use qwen2.5-coder:32b-instruct-q4_K_M  (or a 14b model)
MODEL=qwen2.5-coder:32b-instruct-q8_0

# ─── Delivery: email ────────────────────────────────────────────────────────
EMAIL_TO=krstoferstephen@gmail.com
EMAIL_FROM=krstoferstephen@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=krstoferstephen@gmail.com
# Gmail App Password (16 chars, NOT your normal password)
SMTP_PASSWORD=xxxxxxxxxxxxxxxx

# ─── Telegram ───────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
# Only this chat id may trigger builds (your own numeric id)
TELEGRAM_CHAT_ID=123456789

# ─── Trigger (Cloud Function) ───────────────────────────────────────────────
FUNCTION_NAME=code-builder-trigger

# ─── Safety: hard timeout / anti-runaway ────────────────────────────────────
# A watchdog force-stops the VM after this many minutes NO MATTER WHAT (even if
# a build hangs or the model server wedges), so it can never run 24/7. You get
# a Telegram alert when it fires. Keep this a bit above your longest build.
MAX_RUNTIME_MIN=60

# ─── Internet search (via Tor) ──────────────────────────────────────────────
# off    = no web access during builds
# manual = only search lines you put in the task ("search: <query>")
# auto   = manual + one query auto-derived from the task
ENABLE_RESEARCH=manual
RESEARCH_MAX_RESULTS=5

# ─── Guardrails: topic safety YOU control ───────────────────────────────────
# off      = build anything
# keyword  = refuse tasks containing GUARDRAIL_BLOCK terms (fast, pre-boot)
# strict   = keyword + the local model judges the task against GUARDRAIL_POLICY
GUARDRAIL_MODE=keyword
# Comma-separated terms that always get refused (checked before the GPU boots):
GUARDRAIL_BLOCK=malware,ransomware,phishing,ddos,exploit kit,credential stealer
# Plain-English policy the model enforces in 'strict' mode. Edit to your scope:
GUARDRAIL_POLICY=Only build lawful software: web apps, APIs, scripts, tools, data pipelines, games, and automation. Refuse anything designed to harm, deceive, surveil, or attack people or systems, or to break the law.
