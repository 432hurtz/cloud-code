# ─── Scaleway (EU / GDPR host) ──────────────────────────────────────────────
# Console → IAM → API keys. Scope the key to Instances only (least privilege).
SCW_ACCESS_KEY=SCWXXXXXXXXXXXXXXXXXX
SCW_SECRET_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
SCW_DEFAULT_PROJECT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# GPU zone — L40S / L4 live in fr-par-2 (Paris), also nl-ams-1, pl-waw-2.
SCW_ZONE=fr-par-2

# ─── Builder (GPU instance) ─────────────────────────────────────────────────
# L40S-1-48G (48 GB) runs the 32B coder at q8 comfortably. Cheaper alternative:
#   BUILDER_TYPE=L4-1-24G  paired with a q4 model (see MODEL below).
# Billing pauses while the instance is powered off, so you pay GPU only while
# it's actually building — the call-only model works here.
BUILDER_TYPE=L40S-1-48G
BUILDER_NAME=code-builder
BUILDER_IMAGE=ubuntu_jammy
# Size of the persistent root (block) volume — holds the OS, the model, and the
# agent code, and survives stop/start. 80 GB leaves room for the ~34 GB model.
MODEL_VOLUME_GB=80
# Ollama model tag. 48 GB L40S fits q8. On L4 24 GB use ...-32b-instruct-q4_K_M
MODEL=qwen2.5-coder:32b-instruct-q8_0

# ─── Delivery: email ────────────────────────────────────────────────────────
EMAIL_TO=krstoferstephen@gmail.com
EMAIL_FROM=krstoferstephen@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=krstoferstephen@gmail.com
# Gmail App Password (16 chars, NOT your normal password)
SMTP_PASSWORD=xxxxxxxxxxxxxxxx

# ─── Telegram ───────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
# Only this chat id may trigger builds (your own numeric id)
TELEGRAM_CHAT_ID=123456789

# ─── Controller (always-on trigger) ─────────────────────────────────────────
# A tiny instance that long-polls Telegram and starts the builder (~€2-7/mo).
# No public webhook is exposed — it only makes outbound calls. You can also run
# controller/poller.py on your OWN always-on machine to keep the Scaleway API
# key off the cloud entirely (see README).
CONTROLLER_TYPE=PLAY2-NANO
CONTROLLER_NAME=code-controller
# Set after create-builder.sh prints it (or pass as arg to create-controller.sh):
BUILDER_ID=

# ─── Optional hardening ─────────────────────────────────────────────────────
# Egress lockdown: run `bash deploy/create-security-group.sh`, then paste the id
# here. create-builder.sh / create-controller.sh attach it automatically so the
# instances can only reach the ports the workload needs.
SECURITY_GROUP_ID=
# Secret Manager: run `bash deploy/put-secrets.sh`, then paste the ids here and
# re-run create-builder.sh / create-controller.sh. The Gmail password and bot
# token then live in Secret Manager instead of instance user-data.
SMTP_PASSWORD_SECRET_ID=
TELEGRAM_TOKEN_SECRET_ID=

# ─── Privacy: end-to-end encryption of deliverables (age) ───────────────────
# Generate a keypair ON YOUR OWN MACHINE (the private key never leaves it):
#     age-keygen -o ~/.age/key.txt        # prints "Public key: age1..."
# Paste that PUBLIC key here. The VM encrypts every zip to it before emailing /
# sending, so Gmail, Telegram, and the host only ever hold ciphertext.
# Decrypt locally:  age -d -i ~/.age/key.txt -o build.zip build-*.zip.age
# Leave blank to send plaintext zips (encryption is off).
RECIPIENT_AGE_PUBKEY=

# ─── Safety: hard timeout / anti-runaway ────────────────────────────────────
# A watchdog force-stops the VM after this many minutes NO MATTER WHAT (even if
# a build hangs or the model server wedges), so it can never run 24/7. You get
# a Telegram alert when it fires. Keep this a bit above your longest build.
MAX_RUNTIME_MIN=60

# ─── Internet search (via Tor) ──────────────────────────────────────────────
# off    = no web access during builds
# manual = only search lines you put in the task ("search: <query>")
# auto   = manual + one query auto-derived from the task
ENABLE_RESEARCH=manual
RESEARCH_MAX_RESULTS=5

# ─── Guardrails: topic safety YOU control ───────────────────────────────────
# off      = build anything
# keyword  = only the fast pre-boot GUARDRAIL_BLOCK term check
# strict   = keyword check PLUS the local model reads GUARDRAIL_POLICY and
#            decides allow/block for each request (this is the real one — no
#            keyword matching, it reasons about intent). Recommended.
GUARDRAIL_MODE=strict
#
# Fast pre-boot term check. Obvious no-go words refused before the GPU even
# boots (costs nothing). Leave blank to rely only on the policy below.
GUARDRAIL_BLOCK=malware,ransomware,phishing,ddos,exploit kit,credential stealer
#
# YOUR RULEBOOK — what to allow and what to refuse, in your own words. In
# 'strict' mode the model judges every request against exactly this text, so
# write it like you'd brief a person. Multi-line is fine (keep it one line in
# this file, or set it in the deploy shell). Example is a starting point —
# replace it with yours:
GUARDRAIL_POLICY=You build lawful, constructive software only: web apps, APIs, CLIs, scripts, data pipelines, games, bots, and automation. Refuse anything whose primary purpose is to harm, deceive, surveil, defraud, or attack people or systems — malware, credential theft, spam/phishing, scrapers that violate a site's terms, mass-messaging tools, or anything illegal. If a request is ambiguous, lean toward refusing and say why.

# ─── Agent behavior: HOW it should build (your system prompt) ────────────────
# Injected into every build as the agent's operating instructions — your
# voice, standards, and defaults. This shapes HOW it works; GUARDRAIL_POLICY
# above governs WHAT it will/won't touch. Edit freely:
AGENT_INSTRUCTIONS=Write clean, production-ready code with sensible defaults. Include a README with run instructions, a requirements/deps file, and basic tests where it makes sense. Prefer well-known libraries. Add short comments only where the intent isn't obvious. Don't leave TODOs or half-finished stubs — deliver something that runs.
